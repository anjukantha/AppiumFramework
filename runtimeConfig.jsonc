{
   "execution": {
     "platform": "android",
     "retryCount": 1,
     "waitTimeoutSeconds": 15
   },
   "appium": {
     "serverUrl": "http://127.0.0.1:4723",
     "android": {
       "app": "apps/ApiDemos-release.apk",
       "appPackage": "io.appium.android.apis",
       "platformVersion": "",
       "udids": ""
     },
     "ios": {
       "app": "apps/TestApp.app",
       "bundleId": "",
       "platformVersion": "17.5",
       "udids": ""
     }
   },
   "capabilities": {
     "common": {
       "noReset": true,
       "fullReset": false,
       "newCommandTimeout": 120
     },
     "android": {
       "ignoreHiddenApiPolicyError": true,
       "autoGrantPermissions": true
     },
     "ios": {
       "autoAcceptAlerts": true
     }
   },
   "screenshot": {
     "mode": "failure",
     "onStep": false
   },
   "report": {
     "productName": "ApiDemos",
     "teamName": "QA Automation",
     "runType": "Regression"
   }
 }